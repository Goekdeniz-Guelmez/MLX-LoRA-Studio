# Copy this file to apple/signing.local.env. The local file is gitignored.
# Values use shell assignment syntax; quote values that contain spaces or special characters.
#
# Developer ID Application identity, as shown by:
#   security find-identity -v -p codesigning
CODE_SIGN_IDENTITY=''
NOTARY_TEAM_ID=''

# Recommended: create this profile once in the login keychain. notarytool
# prompts for the app-specific password when you run:
#   xcrun notarytool store-credentials mlx_lora_studio --apple-id you@example.com --team-id TEAMID
# Then set NOTARY_PROFILE='mlx_lora_studio' to enable local notarization.
NOTARY_PROFILE=''

# Optional alternative to a keychain profile. Set NOTARY_APPLE_ID and
# NOTARY_PASSWORD with NOTARY_TEAM_ID. Prefer the keychain profile so the
# app-specific password does not need to be stored in this file.
